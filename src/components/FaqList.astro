---
interface Props {
  items: { q: string; a: string }[];
  /** Open the first item so the section does not look empty. */
  openFirst?: boolean;
}

const { items, openFirst = true } = Astro.props;
---

<div class="faq">
  {items.map((item, index) => (
    <details open={openFirst && index === 0}>
      <summary>{item.q}</summary>
      <div class="faq__answer"><p>{item.a}</p></div>
    </details>
  ))}
</div>
