---
import type { Car } from '~/lib/cars';
import { resolveImage } from '~/lib/image';
import { formatPrice } from '~/lib/format';
import { path, t, type Locale } from '~/i18n';

interface Props {
  car: Car;
  locale: Locale;
  /** The first cards above the fold should not be lazy-loaded. */
  priority?: boolean;
}

const { car, locale, priority = false } = Astro.props;
const d = t(locale);
const href = path('car', locale, car.slug);
const title = car.year ? `${car.name} ${car.year}` : car.name;

// 4:3 — what phones and the original listing photos actually are, so the
// crop stops slicing the roof and wheels off.
const image = resolveImage(car.image, { width: 640, height: 480 });

// "COMPACT · AUTOMATIC · DIESEL · 5 SEATS" — the mono spec line of 2b.
const meta = [
  car.category || null,
  car.transmission ? d.common.values[car.transmission] : null,
  car.fuel ? d.common.values[car.fuel] : null,
  car.seats ? `${car.seats} ${d.common.specs.seats.toLowerCase()}` : null,
].filter(Boolean) as string[];
---

<article class={`card${car.available ? '' : ' card--out'}`}>
  <div class="card__media">
    <a href={href} tabindex="-1" aria-hidden="true">
      <img
        src={image.src}
        srcset={image.srcset || undefined}
        sizes="(max-width: 700px) 100vw, (max-width: 1440px) 32vw, 440px"
        width={image.width}
        height={image.height}
        alt={d.common.carImageAlt(car.name)}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
      />
    </a>
    {!car.available && <span class="badge">{d.common.unavailable}</span>}
  </div>

  <div class="card__body">
    <div class="card__head">
      <h3 class="card__title"><a href={href}>{title}</a></h3>
      {car.pricePerDay !== null && (
        <p class="card__price">
          {formatPrice(car.pricePerDay, locale)}<small>/{d.common.perDay}</small>
        </p>
      )}
    </div>

    {meta.length > 0 && (
      <p class="card__meta">
        {meta.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <span>{item}</span>
          </>
        ))}
      </p>
    )}

    {/*
      One neutral action per card.
      "Ask on WhatsApp" used to sit on every card, so the green CTA repeated
      once per car down the whole grid and stopped reading as the primary
      action anywhere. WhatsApp is still one tap away — on the car's own page,
      in the hero, and in the floating button that follows the page.
    */}
    <div class="card__actions">
      <a class="btn btn--ghost btn--block" href={href}>
        {car.available ? d.common.details : d.common.askOtherDates}
      </a>
    </div>
  </div>
</article>
