---
import Icon from './Icon.astro';
import { site } from '~/config/site';
import { LOCALES, path, t, type Locale, type RouteKey } from '~/i18n';
import { genericWhatsappLink } from '~/lib/whatsapp';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const d = t(locale);

// Mockup 2b: Cars · FAQ · Contact. Contact jumps to the footer, which carries
// the address, hours and phone.
const items = [
  { key: 'cars', label: d.nav.cars, href: path('cars', locale) },
  { key: 'faq', label: d.nav.faq, href: path('faq', locale) },
  { key: 'contact', label: d.nav.contact, href: '#contact' },
];

/**
 * The language switch keeps the visitor on the same page in the other
 * language — a car detail page carries its slug across.
 */
const slug = routeKey === 'car' ? Astro.url.pathname.split('/').filter(Boolean).pop() : undefined;
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={path('home', locale)}>{site.name}</a>

    <div class="header__right">
      <nav class="nav" aria-label={d.nav.mainLabel}>
        {items.map((item) => (
          <a href={item.href} aria-current={item.key === routeKey ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <span class="lang">
        {LOCALES.map((code, index) => (
          <>
            {index > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
            {code === locale ? (
              <span aria-current="true">{code.toUpperCase()}</span>
            ) : (
              <a href={path(routeKey, code, slug)} hreflang={code} rel="alternate" title={d.meta.switchLabel}>
                {code.toUpperCase()}
              </a>
            )}
          </>
        ))}
      </span>

      <a
        class="btn btn--wa btn--head"
        href={genericWhatsappLink(locale)}
        target="_blank"
        rel="noopener"
        aria-label={d.common.whatsappCta}
        data-wa="header"
      >
        <Icon name="whatsapp" size={16} />
        <span>{d.common.whatsappUs}</span>
      </a>
    </div>
  </div>
</header>
