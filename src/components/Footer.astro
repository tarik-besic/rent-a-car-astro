---
import { site, googleMapsUrl } from '~/config/site';
import { LOCALES, path, t, type Locale, type RouteKey } from '~/i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const d = t(locale);
const slug = routeKey === 'car' ? Astro.url.pathname.split('/').filter(Boolean).pop() : undefined;
---

<footer class="footer" id="contact">
  <div class="container footer__inner">
    <p>
      <a href={googleMapsUrl} target="_blank" rel="noopener">
        {site.address.street}, {site.address.postalCode} {site.address.city}
      </a>
      {' · '}{d.common.hoursShort}{' · '}
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    </p>

    <p class="footer__links">
      {LOCALES.map((code, index) => (
        <>
          {index > 0 && ' / '}
          {code === locale ? (
            <span aria-current="true">{code.toUpperCase()}</span>
          ) : (
            <a href={path(routeKey, code, slug)} hreflang={code}>{code.toUpperCase()}</a>
          )}
        </>
      ))}
      {' · '}
      <a href={path('faq', locale)}>{d.nav.faq}</a>
      {' · '}
      <a href="/sitemap.xml">{d.footer.sitemap}</a>
    </p>
  </div>
</footer>
