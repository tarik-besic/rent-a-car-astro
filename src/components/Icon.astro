interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const icon = ICONS[name] ?? ICONS.check;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icon.body}
/>
