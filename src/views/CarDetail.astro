---
import Base from '~/layouts/Base.astro';
import CarCard from '~/components/CarCard.astro';
import Icon from '~/components/Icon.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { abs, path, t, type Locale } from '~/i18n';
import { getRelatedCars, type Car } from '~/lib/cars';
import { imageUrl, resolveImage } from '~/lib/image';
import { formatPrice, truncate } from '~/lib/format';
import { breadcrumbSchema, carSchema } from '~/lib/schema';
import { carWhatsappLink } from '~/lib/whatsapp';

interface Props {
  locale: Locale;
  car: Car;
}

const { locale, car } = Astro.props;
const d = t(locale);

const related = await getRelatedCars(Astro.locals.runtime.env.DB, car, 3);

const gallery = [car.image, ...car.images].filter(Boolean);
const main = resolveImage(gallery[0] ?? '', { width: 1200, height: 800 });
const thumbs = gallery.slice(0, 6).map((source) => ({
  full: resolveImage(source, { width: 1200, height: 800 }),
  thumb: resolveImage(source, { width: 240, height: 160 }),
}));

const title = d.car.titleTemplate(car.name);
const description =
  car.description[locale] && car.description[locale].length > 60
    ? truncate(car.description[locale], 165)
    : d.car.descriptionTemplate(car.name, car.pricePerDay !== null ? String(car.pricePerDay) : '');

// "COMPACT · AVAILABLE" — the eyebrow above the name in 1e.
const eyebrow = [car.category, car.available ? d.common.available : d.common.unavailable]
  .filter(Boolean)
  .join(' · ');

/**
 * Tiered price table (1e): one row per rate the car has, labelled with the
 * day range it applies to. The cheapest, longest tier is highlighted.
 */
const rates: { label: string; value: number }[] = [];
if (car.pricePerDay !== null) {
  const firstEnd = car.price3Day !== null ? 2 : car.price7Day !== null ? 6 : null;
  rates.push({
    label: firstEnd === null ? d.car.pricingDay : d.car.tier(1, firstEnd),
    value: car.pricePerDay,
  });
  if (car.price3Day !== null) {
    rates.push({ label: d.car.tier(3, car.price7Day !== null ? 6 : null), value: car.price3Day });
  }
  if (car.price7Day !== null) rates.push({ label: d.car.tier(7, null), value: car.price7Day });
}

const seatsDoors = [car.seats, car.doors].filter((value) => value !== null).join(' / ');
const specs = [
  car.transmission && { label: d.common.specs.transmission, value: d.common.values[car.transmission] },
  car.fuel && { label: d.common.specs.fuel, value: d.common.values[car.fuel] },
  seatsDoors && {
    label: car.seats !== null && car.doors !== null ? d.common.specs.seatsDoors : car.seats !== null ? d.common.specs.seats : d.common.specs.doors,
    value: seatsDoors,
  },
  car.consumption && { label: d.common.specs.consumption, value: car.consumption },
].filter(Boolean) as { label: string; value: string }[];

// Air conditioning reads as a feature chip in 1e, not a spec cell.
const features =
  car.ac && !car.features.some((feature) => /klima|air.?con|a\/c/i.test(feature))
    ? [d.common.specs.ac, ...car.features]
    : car.features;

const ogImage = gallery[0] ? imageUrl(gallery[0], { width: 1200, height: 630 }) : undefined;

const schema = [
  breadcrumbSchema([
    { name: d.nav.home, url: abs(path('home', locale)) },
    { name: d.nav.cars, url: abs(path('cars', locale)) },
    { name: car.name, url: abs(path('car', locale, car.slug)) },
  ]),
  carSchema(
    car,
    locale,
    gallery.slice(0, 4).map((source) => imageUrl(source, { width: 1200, height: 800 })),
  ),
];

const reserveHref = `${path('reserve', locale)}?car=${encodeURIComponent(car.slug)}`;
---

<Base
  locale={locale}
  routeKey="car"
  slug={car.slug}
  title={title}
  description={description}
  ogType="product"
  ogImage={ogImage?.startsWith('http') ? ogImage : undefined}
  schema={schema}
>
  <section class="section section--page">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: d.nav.home, href: path('home', locale) },
          { name: d.nav.cars, href: path('cars', locale) },
          { name: car.name },
        ]}
      />

      {/*
        On a phone both columns dissolve (display: contents) and the blocks
        run in the 1e order: gallery, name, prices, specs, sticky CTA.
      */}
      <div class="detail">
        <div class="detail__main">
          <div class="gallery" aria-label={d.car.galleryLabel}>
            <div class="gallery__main">
              <img
                id="gallery-main"
                src={main.src}
                srcset={main.srcset || undefined}
                sizes="(max-width: 960px) 100vw, 800px"
                width={main.width}
                height={main.height}
                alt={car.name}
                fetchpriority="high"
                decoding="sync"
              />
            </div>

            {thumbs.length > 1 && (
              <div class="gallery__thumbs" role="tablist" aria-label={d.car.galleryLabel}>
                {thumbs.map((item, index) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={index === 0}
                    data-full={item.full.src}
                    data-srcset={item.full.srcset}
                  >
                    <img
                      src={item.thumb.src}
                      width={item.thumb.width}
                      height={item.thumb.height}
                      alt={`${car.name} — ${index + 1}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="detail__specs">
            {specs.length > 0 && (
              <>
                <h2 class="eyebrow">{d.car.specsHeading}</h2>
                <ul class="specs">
                  {specs.map((spec) => (
                    <li>
                      <span class="k">{spec.label}</span>
                      <span class="v">{spec.value}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {features.length > 0 && (
              <ul class="chips chips--features">
                {features.map((feature) => <li class="pill">{feature}</li>)}
              </ul>
            )}
          </div>
        </div>

        <div class="detail__aside">
          <div class="detail__head">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h1 class="detail__title">
              <span>{car.name}</span>
              {car.year && <span>{car.year}</span>}
            </h1>
            {car.description[locale] && <p class="detail__desc">{car.description[locale]}</p>}
          </div>

          {(rates.length > 0 || car.deposit !== null) && (
            <div class="rates">
              {rates.map((rate, index) => (
                <div class={rates.length > 1 && index === rates.length - 1 ? 'is-best' : index % 2 ? 'is-alt' : undefined}>
                  <span>{rate.label}</span>
                  <b>{formatPrice(rate.value, locale)}</b>
                </div>
              ))}
              {car.deposit !== null && (
                <div class="rates__deposit">
                  <span>{d.common.deposit}</span>
                  <b>{car.deposit === 0 ? d.common.noDeposit : formatPrice(car.deposit, locale)}</b>
                </div>
              )}
            </div>
          )}

          <div class="detail__cta">
            <a
              class="btn btn--wa btn--block"
              href={carWhatsappLink(locale, car.name)}
              target="_blank"
              rel="noopener"
              data-wa="detail"
            >
              <Icon name="whatsapp" size={19} />
              {d.car.whatsappCta}
            </a>
            <a class="detail__link" href={reserveHref}>{d.car.reserveLink} →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head section-head--row">
          <h2>{d.car.relatedHeading}</h2>
        </div>
        <div class="grid grid--cars">
          {related.map((item) => <CarCard car={item} locale={locale} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<script is:inline>
  // Gallery thumbnails: swap the main image source. No library needed.
  (() => {
    const main = document.getElementById('gallery-main');
    const thumbs = document.querySelectorAll('.gallery__thumbs button');
    if (!main || thumbs.length < 2) return;

    thumbs.forEach((button) => {
      button.addEventListener('click', () => {
        const full = button.dataset.full;
        if (!full) return;
        main.src = full;
        main.srcset = button.dataset.srcset || '';
        thumbs.forEach((other) => other.setAttribute('aria-selected', String(other === button)));
      });
    });
  })();
</script>
