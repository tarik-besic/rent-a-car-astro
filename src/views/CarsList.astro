---
import Base from '~/layouts/Base.astro';
import CarCard from '~/components/CarCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { site } from '~/config/site';
import { abs, path, t, type Locale } from '~/i18n';
import { getCategories, getPublishedCars } from '~/lib/cars';
import { breadcrumbSchema } from '~/lib/schema';
import { priceValue } from '~/lib/format';
import { genericWhatsappLink } from '~/lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const FILTER_PARAM = locale === 'bs' ? 'klasa' : 'class';
const activeCategory = Astro.url.searchParams.get(FILTER_PARAM) ?? '';

const db = Astro.locals.runtime.env.DB;
const [allCars, categories] = await Promise.all([getPublishedCars(db), getCategories(db)]);

const sameCategory = (a: string, b: string) => a.toLowerCase() === b.toLowerCase();
const cars = activeCategory ? allCars.filter((car) => sameCategory(car.category, activeCategory)) : allCars;
const countIn = (category: string) => allCars.filter((car) => sameCategory(car.category, category)).length;

const listUrl = path('cars', locale);
const filterHref = (category: string) =>
  category ? `${listUrl}?${FILTER_PARAM}=${encodeURIComponent(category)}` : listUrl;

const prices = cars.map((car) => car.pricePerDay).filter((price): price is number => price !== null);
const lowest = prices.length ? Math.min(...prices) : null;

const schema = [
  breadcrumbSchema([
    { name: d.nav.home, url: abs(path('home', locale)) },
    { name: d.nav.cars, url: abs(listUrl) },
  ]),
  {
    '@type': 'ItemList',
    name: d.cars.h1,
    numberOfItems: cars.length,
    itemListElement: cars.map((car, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: abs(path('car', locale, car.slug)),
      name: car.name,
    })),
  },
  ...(lowest !== null
    ? [
        {
          '@type': 'AggregateOffer',
          offerCount: prices.length,
          lowPrice: priceValue(lowest),
          highPrice: priceValue(Math.max(...prices)),
          priceCurrency: site.currency.code,
        },
      ]
    : []),
];
---

<Base
  locale={locale}
  routeKey="cars"
  title={d.cars.title}
  description={d.cars.description}
  schema={schema}
  noindex={Boolean(activeCategory)}
>
  <section class="section section--page">
    <div class="container">
      <Breadcrumbs
        items={[{ name: d.nav.home, href: path('home', locale) }, { name: d.nav.cars }]}
      />

      <h1 class="page-title">{d.cars.h1}</h1>
      <p class="page-sub">{d.cars.countLabel(allCars.length)} · {d.cars.sub}</p>

      {categories.length > 1 && (
        <ul class="chips chips--scroll chips--filter">
          <li>
            <a
              class={`pill${activeCategory ? '' : ' pill--in'}`}
              href={filterHref('')}
              aria-current={activeCategory ? undefined : 'true'}
            >
              {d.cars.filterAll} {allCars.length}
            </a>
          </li>
          {categories.map((category) => {
            const active = sameCategory(activeCategory, category);
            return (
              <li>
                <a
                  class={`pill${active ? ' pill--in' : ''}`}
                  href={filterHref(category)}
                  aria-current={active ? 'true' : undefined}
                  rel="nofollow"
                >
                  {category} {countIn(category)}
                </a>
              </li>
            );
          })}
        </ul>
      )}

      {cars.length === 0 ? (
        <div class="alert">
          <p style="margin:0 0 1rem">{d.cars.empty}</p>
          <a class="btn btn--wa" href={genericWhatsappLink(locale)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={19} />
            {d.common.whatsappCta}
          </a>
        </div>
      ) : (
        <div class="grid grid--cars">
          {cars.map((car, index) => (
            <CarCard car={car} locale={locale} priority={index < 3} />
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
