---
import Base from '~/layouts/Base.astro';
import CarCard from '~/components/CarCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/config/site';
import { path, t, type Locale } from '~/i18n';
import { FEATURED_COUNT, getFeaturedCars, getPublishedCars, getStartingPrice } from '~/lib/cars';
import { HERO_KEY, getSetting } from '~/lib/settings';
import { PLACEHOLDER, resolveImage } from '~/lib/image';
import { formatPrice } from '~/lib/format';
import { genericWhatsappLink } from '~/lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const db = Astro.locals.runtime.env.DB;
const [featured, allCars, startingPrice, heroKey] = await Promise.all([
  getFeaturedCars(db, FEATURED_COUNT),
  getPublishedCars(db),
  getStartingPrice(db),
  getSetting(db, HERO_KEY),
]);

const priceLabel = startingPrice !== null ? formatPrice(startingPrice, locale) : '';
// The <title> carries the cheapest daily rate — a strong CTR signal in the SERP.
const title = d.home.title.replace('{price}', startingPrice !== null ? String(startingPrice) : '');

/**
 * Blurred backdrop for the hero.
 *
 * Replaces a full-width showcase photo that dominated the fold. As a
 * defocused, darkened layer the same picture gives the hero depth and colour
 * without competing with the headline — and because it is blurred, the small
 * 960px rendition is plenty, so it costs less to load than the sharp version
 * did.
 *
 * Resolution order:
 *   1. PUBLIC_HERO_IMAGE   — explicit editorial override
 *   2. the stored site hero — uploaded at /admin, lives under site/ in R2 and
 *                             survives deleting any car
 *   3. a featured car photo — convenience fallback so a fresh install is not
 *                             blank; this one CAN disappear with its car
 */
const backdropCar =
  featured.find((car) => car.images.length > 1) ??
  featured.find((car) => car.image && car.image !== PLACEHOLDER) ??
  null;

// images[1] keeps the cover photo free for the car's own card.
const backdropSource =
  site.heroImage || heroKey || backdropCar?.images[1] || backdropCar?.image || '';

const backdrop = backdropSource
  ? resolveImage(backdropSource, { width: 960, height: 540 })
  : null;

---

<Base
  locale={locale}
  routeKey="home"
  title={title}
  description={d.home.description}
  ogType="website"
>
  <section class="hero">
    {backdrop && (
      <div class="hero__backdrop" aria-hidden="true">
        <img src={backdrop.src} alt="" width={backdrop.width} height={backdrop.height} fetchpriority="high" decoding="sync" />
      </div>
    )}

    <div class="container">
      <div class="hero__grid">
        <div>
          <p class="hero__eyebrow">
            {d.home.eyebrow}
            {priceLabel && <> · {d.home.priceFrom(priceLabel)}</>}
          </p>
          <h1 class="hero__title">
            {d.home.h1Lines.map((line) => <span>{line}</span>)}
          </h1>
          <p class="hero__body">{d.home.heroBody}</p>

          <div class="hero__actions">
            <a
              class="btn btn--wa btn--xl"
              href={genericWhatsappLink(locale)}
              target="_blank"
              rel="noopener"
              data-wa="hero"
            >
              {d.home.heroCta}
            </a>
            <a class="btn btn--ghost btn--xl" href={path('cars', locale)}>
              {d.common.viewCars}
              <span aria-hidden="true">→</span>
            </a>
            <p class="hero__call">
              <a href={`tel:${site.phone}`}>{d.home.orCall(site.phoneDisplay)}</a>
            </p>
          </div>
        </div>

        {/*
          Quick enquiry — the centrepiece of 2a/2b. Posts to the reservation
          route, which answers with a 303 straight to wa.me, so the shortest
          path to a conversation still works with JS disabled.
        */}
        <form class="quick" method="POST" action={path('reserve', locale)}>
          <h2 class="quick__title">{d.home.quickHeading}</h2>

          <div class="quick__row">
            <div class="field">
              <label for="q-pickup">{d.home.quickLabels.pickup}</label>
              <input id="q-pickup" name="pickupDate" type="date" required />
            </div>
            <div class="field">
              <label for="q-return">{d.home.quickLabels.ret}</label>
              <input id="q-return" name="returnDate" type="date" />
            </div>
          </div>

          <div class="field quick__car">
            <label for="q-car">{d.home.quickLabels.car}</label>
            <select id="q-car" name="car">
              <option value="">{d.home.quickAny}</option>
              {allCars.map((car) => <option value={car.name}>{car.name}</option>)}
            </select>
          </div>

          <button class="btn btn--wa btn--block btn--xl quick__submit" type="submit">
            {d.home.quickSubmit}
          </button>

          <p class="quick__note">{d.home.quickNote}</p>
          <p class="quick__call">
            <a href={`tel:${site.phone}`}>{d.home.orCall(site.phoneDisplay)}</a>
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--fleet" id="fleet">
    <div class="container">
      <div class="section-head section-head--row">
        <h2>{d.home.fleetHeading}</h2>
        <a href={path('cars', locale)}>
          <span class="only-wide">{d.home.fleetAll(allCars.length)}</span>
          <span class="only-narrow">{d.home.fleetAllShort(allCars.length)}</span>
          <span aria-hidden="true"> →</span>
        </a>
      </div>

      <div class="grid grid--cars grid--compact">
        {featured.map((car, index) => (
          <CarCard car={car} locale={locale} priority={index < 2} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
