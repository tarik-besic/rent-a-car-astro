---
import Base from '~/layouts/Base.astro';
import CarCard from '~/components/CarCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/config/site';
import { path, t, type Locale } from '~/i18n';
import { getFeaturedCars, getPublishedCars, getStartingPrice } from '~/lib/cars';
import { PLACEHOLDER, resolveImage } from '~/lib/image';
import { formatPrice } from '~/lib/format';
import { genericWhatsappLink } from '~/lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const db = Astro.locals.runtime.env.DB;
const [featured, allCars, startingPrice] = await Promise.all([
  getFeaturedCars(db, 3),
  getPublishedCars(db),
  getStartingPrice(db),
]);

const priceLabel = startingPrice !== null ? formatPrice(startingPrice, locale) : '';
// The <title> carries the cheapest daily rate — a strong CTR signal in the SERP.
const title = d.home.title.replace('{price}', startingPrice !== null ? String(startingPrice) : '');

/**
 * Photo strip under the hero (2b runs four, 2a three). An explicit
 * PUBLIC_HERO_IMAGE leads; real car photos fill the rest. Slots without a
 * photo keep the hatch ground, as in the mockup.
 */
const STRIP = 4;
const photoCars = allCars.filter((car) => car.image && car.image !== PLACEHOLDER);
const stripSources = [site.heroImage, ...photoCars.map((car) => car.image)].filter(Boolean).slice(0, STRIP);
const strip = Array.from({ length: STRIP }, (_, index) => {
  const source = stripSources[index];
  if (!source) return null;
  const car = photoCars.find((item) => item.image === source);
  return {
    image: resolveImage(source, { width: 800, height: 600 }),
    alt: car ? d.common.carImageAlt(car.name) : d.home.heroImageAlt,
  };
});
---

<Base
  locale={locale}
  routeKey="home"
  title={title}
  description={d.home.description}
  ogType="website"
>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <p class="hero__eyebrow">
            {d.home.eyebrow}
            {priceLabel && <> · {d.home.priceFrom(priceLabel)}</>}
          </p>
          <h1 class="hero__title">
            {d.home.h1Lines.map((line) => <span>{line}</span>)}
          </h1>
          <p class="hero__body">{d.home.heroBody}</p>

          <div class="hero__actions">
            <a
              class="btn btn--wa btn--xl"
              href={genericWhatsappLink(locale)}
              target="_blank"
              rel="noopener"
              data-wa="hero"
            >
              {d.home.heroCta}
            </a>
            <p class="hero__call">
              <a href={`tel:${site.phone}`}>{d.home.orCall(site.phoneDisplay)}</a><br />
              {d.common.hoursShort}
            </p>
          </div>
        </div>

        {/*
          Quick enquiry — the centrepiece of 2a/2b. Posts to the reservation
          route, which answers with a 303 straight to wa.me, so the shortest
          path to a conversation still works with JS disabled.
        */}
        <form class="quick" method="POST" action={path('reserve', locale)}>
          <h2 class="quick__title">{d.home.quickHeading}</h2>

          <div class="quick__row">
            <div class="field">
              <label for="q-pickup">{d.home.quickLabels.pickup}</label>
              <input id="q-pickup" name="pickupDate" type="date" required />
            </div>
            <div class="field">
              <label for="q-return">{d.home.quickLabels.ret}</label>
              <input id="q-return" name="returnDate" type="date" />
            </div>
          </div>

          <div class="field quick__car">
            <label for="q-car">{d.home.quickLabels.car}</label>
            <select id="q-car" name="car">
              <option value="">{d.home.quickAny}</option>
              {allCars.map((car) => <option value={car.name}>{car.name}</option>)}
            </select>
          </div>

          <button class="btn btn--wa btn--block btn--xl quick__submit" type="submit">
            {d.home.quickSubmit}
          </button>

          <p class="quick__note">{d.home.quickNote}</p>
          <p class="quick__call">
            <a href={`tel:${site.phone}`}>{d.home.orCall(site.phoneDisplay)}</a>
          </p>
        </form>
      </div>

      <div class="hero__strip">
        {strip.map((slot, index) => (
          <figure>
            {slot && (
              <img
                src={slot.image.src}
                srcset={slot.image.srcset || undefined}
                sizes="(max-width: 640px) 33vw, 25vw"
                width={slot.image.width}
                height={slot.image.height}
                alt={slot.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--fleet" id="fleet">
    <div class="container">
      <div class="section-head section-head--row">
        <h2>{d.home.fleetHeading}</h2>
        <a href={path('cars', locale)}>
          <span class="only-wide">{d.home.fleetAll(allCars.length)}</span>
          <span class="only-narrow">{d.home.fleetAllShort(allCars.length)}</span>
          <span aria-hidden="true"> →</span>
        </a>
      </div>

      <div class="grid grid--cars grid--compact">
        {featured.map((car, index) => (
          <CarCard car={car} locale={locale} priority={index < 2} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
