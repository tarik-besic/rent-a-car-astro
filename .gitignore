# ---------------------------------------------------------------------------
# SECRETS — never commit.
#
# Real values live in:
#   local dev  -> .dev.vars        (git-ignored, see below)
#   production -> `wrangler secret put NAME`, stored by Cloudflare
#
# .env.example is committed on purpose: it documents the variable NAMES with
# placeholder values and no real credentials.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

