# ---------------------------------------------------------------------------
# Build-time public config.
#
# Vite inlines every PUBLIC_* value into the bundle at build time, so:
#   - NEVER put a secret here (see the bottom of this file for those)
#   - changing one of these needs a redeploy, not just a restart
#
# On Cloudflare these are also mirrored in wrangler.jsonc under "vars", which
# is what the deployed Worker reads. Keep the two in step.
#
# The things that change day to day — the cars — live in D1 and are edited at
# /admin, so routine work never touches this file.
# ---------------------------------------------------------------------------

# Final production origin, no trailing slash.
# Drives canonical URLs, hreflang, sitemap.xml, robots.txt and og:url — and
# must be set at BUILD time, or Astro's CSRF check rejects every reservation
# form POST with a 403 in production.
PUBLIC_SITE_URL=https://auto-rentanje.example.com

PUBLIC_BUSINESS_NAME=Auto Rentanje
PUBLIC_LEGAL_NAME=Auto Rentanje d.o.o.

# THE most important value on the site.
# Full international format, DIGITS ONLY — no "+", no "00", no spaces.
PUBLIC_WHATSAPP=38761524541

PUBLIC_PHONE=+38761524541
PUBLIC_PHONE_DISPLAY=+387 61 524 541
PUBLIC_EMAIL=info@auto-rentanje.ba
PUBLIC_VIBER=

# Office address (separate from the service city below).
PUBLIC_ADDRESS_STREET=Spomenik
PUBLIC_ADDRESS_CITY=Ilidža
PUBLIC_ADDRESS_POSTAL=71101
PUBLIC_ADDRESS_REGION=Kanton Sarajevo
PUBLIC_ADDRESS_COUNTRY=BA

PUBLIC_GEO_LAT=43.839081
PUBLIC_GEO_LNG=18.295747
PUBLIC_MAPS_URL=

# Primary service city, woven into titles and meta descriptions.
PUBLIC_CITY=Sarajevo
# Bosnian locative ("najam vozila u Sarajevu"). Derived automatically; set it
# explicitly for irregular names, e.g. Banja Luka -> Banjoj Luci.
PUBLIC_CITY_LOCATIVE=Sarajevu

PUBLIC_SERVICE_AREAS=Sarajevo, Sarajevo Airport, Ilidža, Vogošća
PUBLIC_OPENING_HOURS=Mo-Sa 08:00-20:00|Su 09:00-17:00

PUBLIC_INSTAGRAM=
PUBLIC_FACEBOOK=

PUBLIC_CURRENCY_CODE=BAM
PUBLIC_CURRENCY_SYMBOL=KM
PUBLIC_YEARS_IN_BUSINESS=10

# Homepage hero. Absolute URL or a /public path. Falls back to the first
# featured car's photo, then /hero-car.jpg.
PUBLIC_HERO_IMAGE=

# ---------------------------------------------------------------------------
# Secrets — DO NOT put these in this file or in wrangler.jsonc.
#
# In production:   npx wrangler secret put ADMIN_PASSWORD
#                  npx wrangler secret put ADMIN_SESSION_SECRET
# Locally:         .dev.vars (git-ignored)
#
# They are read per request from the Worker binding, never at module scope,
# so they are never inlined into any bundle.
#
#   ADMIN_PASSWORD        long; there is no account recovery
#   ADMIN_SESSION_SECRET  openssl rand -base64 32
#   ADMIN_SESSION_HOURS   optional, defaults to 12
# ---------------------------------------------------------------------------
